{
  "name": "dsh-native-harness",
  "version": "0.1.0",
  "description": "Run DeepSeek Harness sessions on the locally installed Claude Code, Codex and Antigravity CLIs",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TungLamC/dsh-plugins.git",
    "directory": "native-harness"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.5"
  },
  "exports": {
    ".": "./lib/host/index.js",
    "./preset": "./lib/host/preset.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "lib/**/*.js",
    "locale/**/*.json",
    "README*.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ]
    }
  },
  "scripts": {
    "build": "node ../scripts/build.ts native-harness",
    "test": "vitest run --root .. native-harness"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.9.1",
    "@anthropic-ai/claude-agent-sdk": "0.3.303"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-agent": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-agent-loop": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-agent-preset": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-agent-preset-registry": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-api-remotes": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-attachment": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-client-locale": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-client-store": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-input-trigger": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-model-selection": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-permission-presets": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-session": ">=0.2.2-rc.5",
